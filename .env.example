# Copie os nomes abaixo para as variáveis de ambiente da hospedagem.
# Nunca coloque os valores reais neste arquivo.

SECRET_KEY=gere-uma-chave-longa-e-aleatoria
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Banco persistente (Turso)
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=seu-token-do-turso

# Usada somente para criar o primeiro usuário admin no banco vazio.
# Depois, a senha pode ser trocada normalmente pelo painel.
ADMIN_INITIAL_PASSWORD=escolha-uma-senha-forte
